# NINA connection
NINA_HOST=localhost
NINA_PORT=1888

# Path to the NINA Target Scheduler v5 SQLite DB (optional override)
# Default: %LOCALAPPDATA%\NINA\SchedulerPlugin\schedulerdb.sqlite
# TS_DB_PATH=

# Discord webhook for human alerts (required for lights-out operation)
DISCORD_WEBHOOK_URL=
# Discord user ID to @mention on ALERT severity
DISCORD_USER_ID=

# Safety thresholds (override defaults in safety.py if your gear/site differs)
# Wind in km/h, cloud in %, dew margin in C
# SAFETY_WIND_MAX=30
# SAFETY_CLOUD_MAX=80
# SAFETY_DEW_MARGIN_MIN=2.0
# SAFETY_HUMIDITY_WARN=95
# SAFETY_COOLER_DELTA_WARN=2.0
# SAFETY_COOLER_DELTA_UNSAFE=10
# SAFETY_TICK_S=5

# --- Phase 3 ---
# Anthropic key (required when Doctor is enabled — i.e. unless --no-doctor)
# ANTHROPIC_API_KEY=sk-ant-...

# Target Scheduler v5 DB path (default: %LOCALAPPDATA%\NINA\SchedulerPlugin\schedulerdb.sqlite)
# TS_DB_PATH=
# NINA profile GUID to scope Planner queries (omit = all profiles)
# TS_PROFILE_ID=

# --- Phase 4 ---
# Web dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_ENABLED=true

# Hard nightly LLM-spend cap. Doctor refuses further calls past this number,
# Conductor treats the resulting BudgetExceeded as a Doctor-driven abort.
# Leave unset to disable the circuit breaker.
# NIGHTLY_BUDGET_USD=5.00
